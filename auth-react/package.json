{
  "name": "ppussh-react",
  "version": "0.1.1",
  "description": "Embeddable PPUSSH authentication (modal + embedded) for products. Accounts remains the source of truth.",
  "author": "PPUSSH <dev@ppussh.com>",
  "homepage": "https://github.com/dev-ppussh/ppussh-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git@github.com:dev-ppussh/ppussh-sdk.git"
  },
  "license": "MIT",
  "keywords": [
    "ppussh",
    "oidc",
    "oauth2",
    "authentication",
    "react"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "lucide-react": "^0.576.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^2.0.0"
  }
}
